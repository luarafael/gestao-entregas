# Copie para .env.production na raiz do projeto (Docker prod)
# cp .env.production.example .env.production

POSTGRES_USER=postgres
POSTGRES_PASSWORD=altere_esta_senha_forte
POSTGRES_DB=sistema_rotas

# URL pública do frontend (CORS no backend)
FRONTEND_URL=http://localhost

# Porta exposta pelo nginx (frontend)
APP_PORT=80

# Deixe vazio quando frontend e API estão no mesmo domínio (nginx faz proxy /api)
VITE_API_URL=
