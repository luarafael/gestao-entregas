# Variáveis por cliente — copie e preencha no painel Railway, Neon e Vercel
# Não commitar valores reais.

# ─── Neon (PostgreSQL) ───
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ─── Railway (API) ───
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://cliente.seudominio.com.br
JWT_SECRET=gerar_com_48_bytes_hex
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@cliente.com.br
ADMIN_PASSWORD=senha_temporaria_forte
ADMIN_NAME=Nome do Admin
MOTOBOY_EMAIL=motoboy@cliente.com.br
MOTOBOY_PASSWORD=senha_temporaria_motoboy
MOTOBOY_NAME=Motoboy Demo
GOOGLE_MAPS_API_KEY=

# ─── Vercel (Frontend) ───
VITE_API_URL=https://api-cliente.up.railway.app
VITE_APP_NAME=Nome do Cliente
VITE_APP_SUBTITLE=Gestão de entregas

# Logo: substituir frontend/public/app-logo.png no deploy do cliente
# (ou configurar build com asset personalizado)
