{
  "name": "sistema-rotas",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Gestão de Entregas e Prestação de Contas",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "prepare": "node -e \"if(!process.env.CI&&!process.env.RAILWAY_ENVIRONMENT){try{require('child_process').execSync('husky',{stdio:'inherit'})}catch(e){process.exit(0)}}\"",
    "dev": "npm run dev --workspace=frontend & npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "test": "npm run test --workspace=frontend && npm run test --workspace=backend",
    "test:coverage": "npm run test:coverage --workspace=frontend && npm run test:coverage --workspace=backend",
    "lint": "npm run lint --workspace=frontend",
    "format": "npm run format --workspace=frontend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:prod": "docker compose -f docker-compose.prod.yml --env-file .env.production up --build -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=backend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "npm run lint --workspace=frontend -- --fix",
      "prettier --write"
    ],
    "backend/**/*.ts": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "typescript": "5.8.3"
  }
}
