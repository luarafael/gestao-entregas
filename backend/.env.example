# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sistema_rotas?schema=public"

# Neon/produção: use pooled no app e direct no Prisma CLI (migrate, studio)
# DATABASE_URL="postgresql://...@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://...@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# Se DIRECT_URL não existir, o prisma.config.ts deriva a URL directa removendo "-pooler" do host.

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (CORS)
FRONTEND_URL="http://localhost:5173"

# Google Maps Routes API (opcional — sem chave usa OSRM + OpenStreetMap, gratuito)
GOOGLE_MAPS_API_KEY=""

# Autenticação (JWT) — obrigatório em produção (mín. 32 caracteres)
# Gerar segredo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="altere-este-segredo-em-producao"
JWT_EXPIRES_IN="7d"

# Usuário admin inicial (criado/atualizado no deploy)
ADMIN_EMAIL="admin@sistema.local"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Administrador"

# Usuário motoboy inicial (opcional — criado/atualizado no deploy se preenchido)
MOTOBOY_EMAIL="motoboy@sistema.local"
MOTOBOY_PASSWORD="motoboy123"
MOTOBOY_NAME="Motoboy Demo"
