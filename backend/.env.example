# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sistema_rotas?schema=public"

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (CORS)
FRONTEND_URL="http://localhost:5173"

# Google Maps Routes API (opcional — sem chave usa OSRM + OpenStreetMap, gratuito)
GOOGLE_MAPS_API_KEY=""

# Autenticação (JWT)
JWT_SECRET="altere-este-segredo-em-producao"
JWT_EXPIRES_IN="7d"

# Usuário admin inicial (criado/atualizado pelo seed)
ADMIN_EMAIL="admin@sistema.local"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Administrador"
