generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusEntrega {
  ENTREGUE
  CANCELADA
}

enum FormaPagamentoEntrega {
  DINHEIRO
  PIX
  CARTAO
}

enum StatusPendencia {
  PENDENTE
  RECEBIDO
}

enum TipoPendencia {
  CLIENTE
  REPASSE_MOTOBOY
}

model Entrega {
  id              String        @id @default(cuid())
  data            DateTime      @db.Date
  horario         DateTime
  nomeCliente     String?
  endereco        String
  bairro          String
  cidade          String?
  observacao      String?
  valorProduto    Decimal?              @map("valor_produto") @db.Decimal(10, 2)
  formaPagamento  FormaPagamentoEntrega? @map("forma_pagamento")
  valorEntrega    Decimal               @db.Decimal(10, 2)
  pagoPeloCliente Boolean       @default(false)
  status          StatusEntrega @default(ENTREGUE)
  motoboyId       String?       @map("motoboy_id")
  motoboy         Usuario?      @relation(fields: [motoboyId], references: [id], onDelete: SetNull)
  criadoEm        DateTime      @default(now())

  @@index([data])
  @@index([bairro])
  @@index([motoboyId])
  @@map("entregas")
}

model Pendencia {
  id             String          @id @default(cuid())
  descricao      String
  valor          Decimal         @db.Decimal(10, 2)
  referenteAoDia DateTime        @db.Date
  status         StatusPendencia @default(PENDENTE)
  tipo           TipoPendencia   @default(CLIENTE)
  motoboyId      String?         @map("motoboy_id")
  motoboy        Usuario?        @relation(fields: [motoboyId], references: [id], onDelete: SetNull)
  criadoEm       DateTime        @default(now())

  @@index([referenteAoDia])
  @@index([status])
  @@index([motoboyId])
  @@index([tipo])
  @@map("pendencias")
}

model PrestacaoContas {
  id                   String             @id @default(cuid())
  data                 DateTime           @unique @db.Date
  totalEntregas        Int
  valorTotal           Decimal            @db.Decimal(10, 2)
  valorPendencias      Decimal            @db.Decimal(10, 2)
  valorFinal           Decimal            @db.Decimal(10, 2)
  valorRepasseMotoboys Decimal            @default(0) @map("valor_repasse_motoboys") @db.Decimal(10, 2)
  valorLiquido         Decimal            @default(0) @map("valor_liquido") @db.Decimal(10, 2)
  observacoes          String?
  criadoEm             DateTime           @default(now())
  prestacoesMotoboy    PrestacaoMotoboy[]

  @@map("prestacoes_contas")
}

enum StatusPrestacaoMotoboy {
  ENVIADA
  APROVADA
  REJEITADA
}

model PrestacaoMotoboy {
  id              String                  @id @default(cuid())
  motoboyId       String                  @map("motoboy_id")
  motoboy         Usuario                 @relation(fields: [motoboyId], references: [id], onDelete: Cascade)
  data            DateTime                @db.Date
  totalEntregas   Int                     @map("total_entregas")
  valorTotal      Decimal                 @map("valor_total") @db.Decimal(10, 2)
  valorPendencias Decimal                 @map("valor_pendencias") @db.Decimal(10, 2)
  valorFinal      Decimal                 @map("valor_final") @db.Decimal(10, 2)
  observacoes     String?
  status          StatusPrestacaoMotoboy  @default(ENVIADA)
  motivoRejeicao  String?                 @map("motivo_rejeicao")
  aprovadaEm      DateTime?               @map("aprovada_em")
  rejeitadaEm         DateTime?               @map("rejeitada_em")
  criadoEm            DateTime                @default(now()) @map("criado_em")
  prestacaoContasId   String?                 @map("prestacao_contas_id")
  prestacaoContas     PrestacaoContas?        @relation(fields: [prestacaoContasId], references: [id], onDelete: SetNull)

  @@unique([motoboyId, data])
  @@index([status])
  @@index([data])
  @@map("prestacoes_motoboy")
}

model PrestacaoCliente {
  id            String   @id @default(cuid())
  nomeCliente   String   @map("nome_cliente")
  data          DateTime @db.Date
  totalEntregas Int      @map("total_entregas")
  valorTotal    Decimal  @map("valor_total") @db.Decimal(10, 2)
  valorFinal    Decimal  @map("valor_final") @db.Decimal(10, 2)
  observacoes   String?
  criadoEm      DateTime @default(now()) @map("criado_em")

  @@unique([nomeCliente, data])
  @@index([data])
  @@map("prestacoes_cliente")
}

enum PrioridadeParada {
  NORMAL
  URGENTE
}

enum StatusExecucaoParada {
  PENDENTE
  EM_ROTA
  ENTREGUE
  CLIENTE_AUSENTE
  NAO_LOCALIZADO
  CANCELADA
  FALHA_ENTREGA
}

model RotaPlanejada {
  id               String       @id @default(cuid())
  data             DateTime     @db.Date
  enderecoInicial  String
  distanciaTotal   Decimal      @db.Decimal(12, 2)
  tempoTotal       Int
  aproximada       Boolean      @default(false)
  motoboyId        String?      @map("motoboy_id")
  criadoEm         DateTime     @default(now())
  paradas          RotaParada[]
  execucoes        RotaExecucao[]
  motoboy          Usuario?     @relation(fields: [motoboyId], references: [id], onDelete: SetNull)

  @@index([data])
  @@index([motoboyId])
  @@map("rotas_planejadas")
}

model RotaParada {
  id           String           @id @default(cuid())
  rotaId       String
  entregaId    String?
  cliente      String?
  endereco     String
  bairro       String?
  telefone     String?
  observacao   String?
  ordem        Int
  distancia    Decimal?         @db.Decimal(12, 2)
  tempo        Int?
  prioridade   PrioridadeParada @default(NORMAL)
  ordemUrgencia  Int?
  valorEntrega Decimal?         @db.Decimal(10, 2)
  latitude     Float?
  longitude    Float?
  rota         RotaPlanejada    @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  execucoes    RotaExecucao[]

  @@index([rotaId])
  @@index([entregaId])
  @@map("rota_paradas")
}

model RotaExecucao {
  id             String               @id @default(cuid())
  rotaId         String
  paradaId       String?
  entregaId      String?
  ordem          Int
  status         StatusExecucaoParada @default(PENDENTE)
  dataHoraStatus DateTime?
  observacao     String?
  criadoEm       DateTime             @default(now())
  atualizadoEm   DateTime             @updatedAt
  rota           RotaPlanejada        @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  parada         RotaParada?          @relation(fields: [paradaId], references: [id], onDelete: SetNull)

  @@index([rotaId])
  @@index([paradaId])
  @@index([entregaId])
  @@map("rota_execucao")
}

enum UsuarioRole {
  ADMIN
  MOTOBOY
}

model Usuario {
  id           String      @id @default(cuid())
  nome         String
  email        String      @unique
  senhaHash    String      @map("senha_hash")
  pix          String?
  role         UsuarioRole @default(MOTOBOY)
  ativo        Boolean     @default(true)
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")
  entregas           Entrega[]
  pendencias         Pendencia[]
  prestacoesMotoboy  PrestacaoMotoboy[]
  rotasPlanejadas    RotaPlanejada[]

  @@map("usuarios")
}

model ConfiguracaoPlanejador {
  id                    String   @id @default("default")
  enderecoPartidaPadrao String
  atualizadoEm          DateTime @updatedAt

  @@map("configuracao_planejador")
}
