generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusEntrega {
  ENTREGUE
  CANCELADA
}

enum StatusPendencia {
  PENDENTE
  RECEBIDO
}

model Entrega {
  id           String        @id @default(cuid())
  data         DateTime      @db.Date
  horario      DateTime
  nomeCliente  String?
  endereco     String
  bairro       String
  cidade       String?
  observacao   String?
  valorEntrega Decimal       @db.Decimal(10, 2)
  pagoPeloCliente Boolean    @default(false)
  status       StatusEntrega @default(ENTREGUE)
  criadoEm     DateTime      @default(now())

  @@index([data])
  @@index([bairro])
  @@map("entregas")
}

model Pendencia {
  id             String          @id @default(cuid())
  descricao      String
  valor          Decimal         @db.Decimal(10, 2)
  referenteAoDia DateTime        @db.Date
  status         StatusPendencia @default(PENDENTE)
  criadoEm       DateTime        @default(now())

  @@index([referenteAoDia])
  @@index([status])
  @@map("pendencias")
}

model PrestacaoContas {
  id              String   @id @default(cuid())
  data            DateTime @unique @db.Date
  totalEntregas   Int
  valorTotal      Decimal  @db.Decimal(10, 2)
  valorPendencias Decimal  @db.Decimal(10, 2)
  valorFinal      Decimal  @db.Decimal(10, 2)
  observacoes     String?
  criadoEm        DateTime @default(now())

  @@map("prestacoes_contas")
}

enum PrioridadeParada {
  NORMAL
  URGENTE
}

model RotaPlanejada {
  id               String       @id @default(cuid())
  data             DateTime     @db.Date
  enderecoInicial  String
  distanciaTotal   Decimal      @db.Decimal(12, 2)
  tempoTotal       Int
  aproximada       Boolean      @default(false)
  criadoEm         DateTime     @default(now())
  paradas          RotaParada[]

  @@index([data])
  @@map("rotas_planejadas")
}

model RotaParada {
  id           String           @id @default(cuid())
  rotaId       String
  entregaId    String?
  cliente      String?
  endereco     String
  bairro       String?
  observacao   String?
  ordem        Int
  distancia    Decimal?         @db.Decimal(12, 2)
  tempo        Int?
  prioridade   PrioridadeParada @default(NORMAL)
  ordemUrgencia  Int?
  valorEntrega Decimal?         @db.Decimal(10, 2)
  latitude     Float?
  longitude    Float?
  rota         RotaPlanejada    @relation(fields: [rotaId], references: [id], onDelete: Cascade)

  @@index([rotaId])
  @@index([entregaId])
  @@map("rota_paradas")
}

model ConfiguracaoPlanejador {
  id                    String   @id @default("default")
  enderecoPartidaPadrao String
  atualizadoEm          DateTime @updatedAt

  @@map("configuracao_planejador")
}
